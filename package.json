{
  "name": "tau-mirror",
  "version": "1.0.9-itissid.2",
  "description": "Terminal-safe, proxy-aware fork of Tau for mirroring Pi sessions in a browser",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "coding-agent",
    "web-ui",
    "mirror"
  ],
  "author": "deflating",
  "contributors": [
    "itissid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itissid/tau.git"
  },
  "pi": {
    "extensions": [
      "./extensions/mirror-server.ts"
    ],
    "image": "https://raw.githubusercontent.com/itissid/tau/main/docs/images/dark.png"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:hub",
    "test:node": "node --test test/*.test.ts",
    "test:hub": "npm --prefix hub test",
    "test:pty": "python3 test/pty-learning-test.py",
    "test:mirrors": "python3 hub/test/real-mirrors-learning-test.py"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.21.3"
  }
}
